FUSEKI_PASSWORD=admin
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI Assistant - tried in this order, first one configured wins (no mixing):
# 1) Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 2) OpenAI - used if ANTHROPIC_API_KEY is blank
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# 3) Ollama (local, no key needed) - used if both keys above are blank. Requires
# Ollama running locally with a tool/function-calling-capable model pulled (e.g.
# `ollama pull llama3.1`). If running the backend via Docker Compose on
# Windows/Mac, change localhost to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
# 0) Self-hosted OpenAI-compatible endpoint (vLLM, TGI, LM Studio, private
# gateway). If LLM_MODEL + LLM_BASE_URL are set, this takes precedence over all
# of the above so a local server "just works" with no cloud key. The model must
# support tool/function calling. Include /v1 if your server serves the chat API
# under it. LLM_API_KEY can be any non-empty string if the server doesn't check.
LLM_BASE_URL=http://10.10.17.55:80/v1
LLM_MODEL=gpt-20b:latest
LLM_API_KEY=not-needed
